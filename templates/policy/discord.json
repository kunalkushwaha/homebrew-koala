{"format": 1, "name": "discord", "version": 1,
 "description": "The Discord REST API, with a bot token (the Gateway is not brokered)",
 "groups": {
   "messages": [{"method": "GET", "path": "/api/v10/channels/{channel}/messages", "query": ["limit", "before", "after", "around"]},
                {"method": "POST", "path": "/api/v10/channels/{channel}/messages"},
                {"method": "PATCH", "path": "/api/v10/channels/{channel}/messages/{message}"},
                {"method": "DELETE", "path": "/api/v10/channels/{channel}/messages/{message}"},
                {"method": "POST", "path": "/api/v10/channels/{channel}/typing"}],
   "identity": [{"method": "GET", "path": "/api/v10/users/@me"}],
   "channels": [{"method": "GET", "path": "/api/v10/channels/{channel}"}]},
 "defaultGroups": ["identity", "messages"],
 "policy": {"version": 1,
  "upstream": {"origin": "https://discord.com"},
  "auth": {"scheme": "authorization", "type": "Bot"},
  "requestHeaders": ["content-type", "accept", "user-agent", "x-audit-log-reason"],
  "responseHeaders": ["content-type", "retry-after", "x-ratelimit-limit", "x-ratelimit-remaining", "x-ratelimit-reset",
                      "x-ratelimit-reset-after", "x-ratelimit-bucket", "x-ratelimit-global", "x-ratelimit-scope"],
  "body": {"maxKiB": 1024, "contentTypes": ["application/json"]},
  "perVM": {"requestsPerMinute": 120, "concurrency": 4, "responseMiB": 8, "timeoutSeconds": 60, "idleSeconds": 30},
  "guestEnvironment": {"DISCORD_BOT_TOKEN": "koala-brokered",
                       "DISCORD_API_URL": "http://{grant}.broker.koala.internal/api/v10"}}}
