{"format": 1, "name": "anthropic", "version": 1,
 "description": "The Anthropic Messages API",
 "groups": {
   "messages": [{"method": "POST", "path": "/v1/messages"}],
   "count-tokens": [{"method": "POST", "path": "/v1/messages/count_tokens"}],
   "models": [{"method": "GET", "path": "/v1/models"}, {"method": "GET", "path": "/v1/models/{model}"}]},
 "defaultGroups": ["messages", "models"],
 "modelField": "model",
 "policy": {"version": 1,
  "upstream": {"origin": "https://api.anthropic.com"},
  "auth": {"scheme": "header", "header": "x-api-key"},
  "requestHeaders": ["content-type", "accept", "anthropic-version", "anthropic-beta", "user-agent",
                     "x-stainless-arch", "x-stainless-lang", "x-stainless-os", "x-stainless-package-version",
                     "x-stainless-runtime", "x-stainless-runtime-version", "x-stainless-retry-count"],
  "responseHeaders": ["content-type", "request-id", "retry-after", "anthropic-ratelimit-requests-limit",
                      "anthropic-ratelimit-requests-remaining", "anthropic-ratelimit-requests-reset"],
  "body": {"maxKiB": 4096, "contentTypes": ["application/json"]},
  "perVM": {"requestsPerMinute": 60, "concurrency": 4, "responseMiB": 64, "timeoutSeconds": 600, "idleSeconds": 120},
  "guestEnvironment": {"ANTHROPIC_BASE_URL": "http://{grant}.broker.koala.internal", "ANTHROPIC_API_KEY": "koala-brokered"}}}
