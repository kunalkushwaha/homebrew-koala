{"format": 1, "name": "slack", "version": 1,
 "description": "The Slack Web API, with a bot token",
 "groups": {
   "messages": [{"method": "POST", "path": "/api/chat.postMessage"},
                {"method": "POST", "path": "/api/chat.update"},
                {"method": "POST", "path": "/api/chat.delete"}],
   "read": [{"method": "POST", "path": "/api/auth.test"},
            {"method": "POST", "path": "/api/conversations.history"},
            {"method": "GET", "path": "/api/conversations.history",
             "query": ["channel", "cursor", "inclusive", "latest", "limit", "oldest", "include_all_metadata"]},
            {"method": "POST", "path": "/api/conversations.replies"},
            {"method": "GET", "path": "/api/conversations.replies",
             "query": ["channel", "ts", "cursor", "inclusive", "latest", "limit", "oldest", "include_all_metadata"]},
            {"method": "POST", "path": "/api/conversations.info"},
            {"method": "GET", "path": "/api/conversations.info", "query": ["channel", "include_locale", "include_num_members"]},
            {"method": "POST", "path": "/api/conversations.list"},
            {"method": "GET", "path": "/api/conversations.list", "query": ["cursor", "exclude_archived", "limit", "team_id", "types"]},
            {"method": "POST", "path": "/api/users.info"},
            {"method": "GET", "path": "/api/users.info", "query": ["user", "include_locale"]}],
   "reactions": [{"method": "POST", "path": "/api/reactions.add"},
                 {"method": "POST", "path": "/api/reactions.remove"}],
   "socket-mode": [{"method": "POST", "path": "/api/apps.connections.open"}]},
 "defaultGroups": ["messages", "read"],
 "policy": {"version": 1,
  "upstream": {"origin": "https://slack.com"},
  "auth": {"scheme": "bearer"},
  "requestHeaders": ["content-type", "accept", "user-agent"],
  "responseHeaders": ["content-type", "retry-after"],
  "body": {"maxKiB": 256, "contentTypes": ["application/json", "application/x-www-form-urlencoded"]},
  "perVM": {"requestsPerMinute": 120, "concurrency": 4, "responseMiB": 8, "timeoutSeconds": 60, "idleSeconds": 30},
  "guestEnvironment": {"SLACK_BOT_TOKEN": "xoxb-koala-brokered",
                       "SLACK_API_URL": "http://{grant}.broker.koala.internal/api/"}}}
