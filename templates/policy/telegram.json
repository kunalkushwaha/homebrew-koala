{"format": 2, "name": "telegram", "version": 2,
 "description": "The Telegram Bot API (the bot token goes in the URL path)",
 "groups": {
   "updates": [{"method": "POST", "path": "/bot{key:bot}/getMe"},
               {"method": "POST", "path": "/bot{key:bot}/getUpdates"},
               {"method": "POST", "path": "/bot{key:bot}/deleteWebhook"},
               {"method": "POST", "path": "/bot{key:bot}/getWebhookInfo"}],
   "messages": [{"method": "POST", "path": "/bot{key:bot}/sendMessage"},
                {"method": "POST", "path": "/bot{key:bot}/editMessageText"},
                {"method": "POST", "path": "/bot{key:bot}/deleteMessage"},
                {"method": "POST", "path": "/bot{key:bot}/sendChatAction"},
                {"method": "POST", "path": "/bot{key:bot}/answerCallbackQuery"},
                {"method": "POST", "path": "/bot{key:bot}/setMessageReaction"}],
   "files": [{"method": "POST", "path": "/bot{key:bot}/getFile"},
             {"method": "GET", "path": "/file/bot{key:bot}/{folder}/{file}"},
             {"method": "POST", "path": "/bot{key:bot}/sendPhoto"},
             {"method": "POST", "path": "/bot{key:bot}/sendDocument"},
             {"method": "POST", "path": "/bot{key:bot}/sendAudio"},
             {"method": "POST", "path": "/bot{key:bot}/sendVoice"},
             {"method": "POST", "path": "/bot{key:bot}/sendVideo"}],
   "commands": [{"method": "POST", "path": "/bot{key:bot}/setMyCommands"},
                {"method": "POST", "path": "/bot{key:bot}/getMyCommands"},
                {"method": "POST", "path": "/bot{key:bot}/deleteMyCommands"}]},
 "defaultGroups": ["updates", "messages"],
 "policy": {"version": 2,
  "upstream": {"origin": "https://api.telegram.org"},
  "keys": {"bot": "{credential}"},
  "requestHeaders": ["content-type", "accept", "user-agent"],
  "responseHeaders": ["content-type", "retry-after"],
  "body": {"maxKiB": 10240, "contentTypes": ["application/json", "application/x-www-form-urlencoded", "multipart/form-data"]},
  "perVM": {"requestsPerMinute": 120, "concurrency": 4, "responseMiB": 32, "timeoutSeconds": 120, "idleSeconds": 90},
  "guestEnvironment": {"TELEGRAM_BOT_TOKEN": "0:koala-brokered",
                       "TELEGRAM_BASE_URL": "http://{grant}.broker.koala.internal/bot",
                       "TELEGRAM_BASE_FILE_URL": "http://{grant}.broker.koala.internal/file/bot"}}}
