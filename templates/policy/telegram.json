{"format": 1, "name": "telegram", "version": 1,
 "description": "The Telegram Bot API (the bot token goes in the URL path)",
 "groups": {
   "updates": [{"method": "POST", "path": "/bot{credential}/getMe"},
               {"method": "POST", "path": "/bot{credential}/getUpdates"},
               {"method": "POST", "path": "/bot{credential}/deleteWebhook"},
               {"method": "POST", "path": "/bot{credential}/getWebhookInfo"}],
   "messages": [{"method": "POST", "path": "/bot{credential}/sendMessage"},
                {"method": "POST", "path": "/bot{credential}/editMessageText"},
                {"method": "POST", "path": "/bot{credential}/deleteMessage"},
                {"method": "POST", "path": "/bot{credential}/sendChatAction"},
                {"method": "POST", "path": "/bot{credential}/answerCallbackQuery"},
                {"method": "POST", "path": "/bot{credential}/setMessageReaction"}],
   "files": [{"method": "POST", "path": "/bot{credential}/getFile"},
             {"method": "GET", "path": "/file/bot{credential}/{folder}/{file}"},
             {"method": "POST", "path": "/bot{credential}/sendPhoto"},
             {"method": "POST", "path": "/bot{credential}/sendDocument"},
             {"method": "POST", "path": "/bot{credential}/sendAudio"},
             {"method": "POST", "path": "/bot{credential}/sendVoice"},
             {"method": "POST", "path": "/bot{credential}/sendVideo"}],
   "commands": [{"method": "POST", "path": "/bot{credential}/setMyCommands"},
                {"method": "POST", "path": "/bot{credential}/getMyCommands"},
                {"method": "POST", "path": "/bot{credential}/deleteMyCommands"}]},
 "defaultGroups": ["updates", "messages"],
 "policy": {"version": 1,
  "upstream": {"origin": "https://api.telegram.org"},
  "auth": {"scheme": "path"},
  "requestHeaders": ["content-type", "accept", "user-agent"],
  "responseHeaders": ["content-type", "retry-after"],
  "body": {"maxKiB": 10240, "contentTypes": ["application/json", "application/x-www-form-urlencoded", "multipart/form-data"]},
  "perVM": {"requestsPerMinute": 120, "concurrency": 4, "responseMiB": 32, "timeoutSeconds": 120, "idleSeconds": 90},
  "guestEnvironment": {"TELEGRAM_BOT_TOKEN": "0:koala-brokered",
                       "TELEGRAM_BASE_URL": "http://{grant}.broker.koala.internal/bot",
                       "TELEGRAM_BASE_FILE_URL": "http://{grant}.broker.koala.internal/file/bot"}}}
