{"format": 1, "name": "github", "version": 1,
 "description": "The GitHub REST API, with short-lived tokens minted from a GitHub App's key",
 "groups": {
   "read": [{"method": "GET", "path": "/repos/{owner}/{repo}"},
            {"method": "GET", "path": "/repos/{owner}/{repo}/contents/{path*}", "query": ["ref"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/commits",
             "query": ["sha", "path", "author", "since", "until", "per_page", "page"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/commits/{ref}"},
            {"method": "GET", "path": "/repos/{owner}/{repo}/branches", "query": ["protected", "per_page", "page"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/pulls",
             "query": ["state", "head", "base", "sort", "direction", "per_page", "page"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/pulls/{number}"},
            {"method": "GET", "path": "/repos/{owner}/{repo}/pulls/{number}/files", "query": ["per_page", "page"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/issues",
             "query": ["state", "labels", "assignee", "creator", "sort", "direction", "since", "per_page", "page"]},
            {"method": "GET", "path": "/repos/{owner}/{repo}/issues/{number}"},
            {"method": "GET", "path": "/repos/{owner}/{repo}/issues/{number}/comments", "query": ["since", "per_page", "page"]}],
   "issues-write": [{"method": "POST", "path": "/repos/{owner}/{repo}/issues"},
                    {"method": "PATCH", "path": "/repos/{owner}/{repo}/issues/{number}"},
                    {"method": "POST", "path": "/repos/{owner}/{repo}/issues/{number}/comments"}],
   "pulls-write": [{"method": "POST", "path": "/repos/{owner}/{repo}/pulls"},
                   {"method": "PATCH", "path": "/repos/{owner}/{repo}/pulls/{number}"},
                   {"method": "POST", "path": "/repos/{owner}/{repo}/pulls/{number}/reviews"},
                   {"method": "POST", "path": "/repos/{owner}/{repo}/issues/{number}/comments"}]},
 "groupPermissions": {
   "read": {"metadata": "read", "contents": "read", "issues": "read", "pull_requests": "read"},
   "issues-write": {"issues": "write"},
   "pulls-write": {"pull_requests": "write"}},
 "defaultGroups": ["read"],
 "policy": {"version": 1,
  "upstream": {"origin": "https://api.github.com"},
  "auth": {"scheme": "github-app"},
  "requestHeaders": ["accept", "content-type", "user-agent", "x-github-api-version"],
  "responseHeaders": ["content-type", "etag", "link", "retry-after", "x-github-request-id", "x-ratelimit-limit",
                      "x-ratelimit-remaining", "x-ratelimit-reset", "x-ratelimit-used", "x-ratelimit-resource"],
  "body": {"maxKiB": 1024, "contentTypes": ["application/json"]},
  "perVM": {"requestsPerMinute": 300, "concurrency": 4, "responseMiB": 16, "timeoutSeconds": 60, "idleSeconds": 30},
  "guestEnvironment": {"GITHUB_API_URL": "http://{grant}.broker.koala.internal"}}}
