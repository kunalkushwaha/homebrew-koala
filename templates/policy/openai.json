{"format": 1, "name": "openai", "version": 1,
 "description": "OpenAI, and APIs with the same shape under /v1 (Together, DeepSeek, Mistral and others: set --origin)",
 "groups": {
   "chat": [{"method": "POST", "path": "/v1/chat/completions"}],
   "responses": [{"method": "POST", "path": "/v1/responses"}],
   "embeddings": [{"method": "POST", "path": "/v1/embeddings"}],
   "models": [{"method": "GET", "path": "/v1/models"}, {"method": "GET", "path": "/v1/models/{model}"}]},
 "defaultGroups": ["chat", "models"],
 "modelField": "model",
 "policy": {"version": 1,
  "upstream": {"origin": "https://api.openai.com"},
  "auth": {"scheme": "bearer"},
  "requestHeaders": ["content-type", "accept", "user-agent", "x-stainless-arch", "x-stainless-lang",
                     "x-stainless-os", "x-stainless-package-version", "x-stainless-runtime",
                     "x-stainless-runtime-version", "x-stainless-retry-count"],
  "responseHeaders": ["content-type", "x-request-id", "retry-after", "x-ratelimit-limit-requests",
                      "x-ratelimit-remaining-requests", "x-ratelimit-reset-requests"],
  "body": {"maxKiB": 4096, "contentTypes": ["application/json"]},
  "perVM": {"requestsPerMinute": 60, "concurrency": 4, "responseMiB": 64, "timeoutSeconds": 600, "idleSeconds": 120},
  "guestEnvironment": {"OPENAI_BASE_URL": "http://{grant}.broker.koala.internal/v1", "OPENAI_API_KEY": "koala-brokered"}}}
